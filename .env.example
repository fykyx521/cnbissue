# CNB 访问令牌，必填。需包含以下权限：
#   repo-issue:r / repo-issue:rw
#   repo-pr:r    / repo-pr:rw
# 在 https://cnb.cool 个人设置 -> 访问令牌 中创建
CNB_TOKEN=

# 服务端口，默认 3000
PORT=3000

# ---- GitHub 镜像同步（可选，仅 scripts/sync-to-github.sh 使用）----
# 流水线里由 .cnb.yml 的 imports 注入，本地手动跑同步时需要自己填
GITHUB_USERNAME=
GITHUB_TOKEN=
# 目标仓库 owner/name，默认 fykyx521/cnbissue
GITHUB_REPO=
